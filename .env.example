# DxP configuration: names only, never values (D48). Copy to .env, which is git-ignored.
# Secrets live only in .env and the Modal secret; Vercel holds DXP_API_KEY and NEXT_PUBLIC_API_URL.

# MongoDB Atlas Sandbox
MONGODB_URI=
DXP_DB=

# Claude (only through backend/dxp/llm)
ANTHROPIC_API_KEY=

# DxP keys, generated locally by A03 at 10:45 (D48)
DXP_API_KEY=
DXP_AGENT_KEY=
DXP_SEED_KEY=

# Slack notifier and links back to DxP
SLACK_WEBHOOK_URL=
DXP_BASE_URL=
DXP_ALLOWED_ORIGINS=
DXP_DEMO_PACE=

# Embeddings: auto, voyage or none (AD-15); the Voyage key only if cleared (OD1)
DXP_EMBEDDING=
VOYAGE_API_KEY=

# Briefing (OD3) and avatar video (OD7), on demand only (V29)
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=

# Feature flags, comma-separated names; all off unless named.
# Backend (read on the server): task_run (V38; off until I3b passes, V46), revert and live_stream (V48)
DXP_FEATURES=
# Web app, display only: briefing, avatar, memory_edit, task_run, revert, live_stream
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DXP_FEATURES=

# LangSmith tracing
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
