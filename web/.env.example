# Names only. Real values live in web/.env.local (never committed) and in Vercel.
# API origin, without /api/v1. The browser never calls it directly; the server does.
NEXT_PUBLIC_API_URL=
# Same origin, server-only and read at runtime, so it can change without a rebuild. Takes precedence over NEXT_PUBLIC_API_URL on the server.
DXP_API_URL=
# Comma-separated display flags: briefing, avatar, memory_edit, task_run, revert, live_stream. Empty means all off.
NEXT_PUBLIC_DXP_FEATURES=
# Reviewer key, read only on the server by the proxy route. Never NEXT_PUBLIC_.
DXP_API_KEY=
# Optional, used by npm run gen:types: read a running API's /openapi.json instead of building the schema from the backend code.
DXP_OPENAPI_URL=
